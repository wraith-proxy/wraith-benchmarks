FROM node:22-bookworm-slim

ARG COPILOT_VERSION=1.0.105

COPY --from=ghcr.io/astral-sh/uv:0.9.0 /uv /uvx /usr/local/bin/

RUN apt-get update \
 && apt-get install -y --no-install-recommends git python3 ca-certificates bash \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g @github/copilot@${COPILOT_VERSION}

COPY stubs/ /opt/bench/stubs/
COPY entrypoint-copilot.sh /opt/bench/entrypoint-copilot.sh
RUN chmod 0755 /opt/bench/stubs/* /opt/bench/entrypoint-copilot.sh

# Stubs first on PATH. No cloud tools, no credentials, no ANTHROPIC_API_KEY.
ENV PATH=/opt/bench/stubs:/usr/local/bin:/usr/bin:/bin
ENV HOME=/home/bench
RUN /usr/sbin/useradd --create-home --home-dir /home/bench --shell /bin/bash bench
USER bench
WORKDIR /work
ENTRYPOINT ["/opt/bench/entrypoint-copilot.sh"]
